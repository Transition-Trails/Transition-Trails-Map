# Trail OS — Environment Variable Reference
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git. Only .env.example belongs in the repository.
# See SECURITY.md for the full secrets policy.

# ── Server ────────────────────────────────────────────────────────────────────
# Port assigned at runtime by Replit. Do not hardcode.
PORT=

# Express session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string — includes username and password.
# Example format (do not use this value): postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── Salesforce ────────────────────────────────────────────────────────────────
# Connected App credentials from Salesforce Setup → App Manager.
SALESFORCE_CLIENT_ID=your_connected_app_consumer_key
SALESFORCE_CLIENT_SECRET=your_connected_app_consumer_secret

# Login URL for your Salesforce org. Use https://login.salesforce.com for production
# or https://test.salesforce.com for sandbox orgs.
SALESFORCE_INSTANCE_URL=https://login.salesforce.com

# OAuth 2.0 callback URL — must match exactly what is registered in the Connected App.
# Example: https://your-replit-app.replit.app/api/auth/salesforce/callback
SALESFORCE_CALLBACK_URL=https://your-replit-app.replit.app/api/auth/salesforce/callback

# OAuth tokens (obtained after completing the OAuth flow — do not commit).
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_REFRESH_TOKEN=

# ── Slack ─────────────────────────────────────────────────────────────────────
# Bot token from Slack App settings → OAuth & Permissions. Starts with xoxb-.
SLACK_BOT_TOKEN=

# Signing secret from Slack App settings → Basic Information → App Credentials.
SLACK_SIGNING_SECRET=

# ── Google / OAuth ────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# The client_id is a public identifier and safe to commit, but included here for consistency.
GOOGLE_CLIENT_ID=

# The client_secret is NOT public — never commit this value.
GOOGLE_CLIENT_SECRET=

# Redirect URI registered in Google Cloud Console. Example: https://yourapp.replit.app/api/google/oauth/callback
GOOGLE_REDIRECT_URI=

# Stored OAuth tokens (obtained after completing the OAuth flow — do not commit).
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=

# ── Gemini / Google AI ────────────────────────────────────────────────────────
# API key from Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=

# ── Replit (set automatically by Replit at runtime) ───────────────────────────
# These are provided by the Replit environment — do not set manually.
# REPLIT_DEV_DOMAIN=
# REPLIT_DOMAINS=
# REPL_ID=
