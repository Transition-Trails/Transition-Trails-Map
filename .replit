modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["salesforce:1.0.0", "google-drive:1.0.0", "google-calendar:1.0.0", "google-docs:1.0.0", "google-sheet:1.0.0", "google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 25962
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GOOGLE_GROUP_COACHES = "coaches@transitiontrails.org"
GOOGLE_GROUP_LEARNERS = "learners@transitiontrails.org"
GOOGLE_GROUP_VOLUNTEERS = "volunteer@transitiontrails.org"
