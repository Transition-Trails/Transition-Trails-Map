modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

# Pre-build hook: push the Drizzle schema to the production DB before artifact
# builds run.  This keeps dev and prod schemas in sync automatically so the
# publish UI never shows pending schema changes.
# drizzle-kit push --force skips the interactive confirmation prompt.
[deployment.build]
args = ["pnpm", "--filter", "@workspace/db", "run", "push-force"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["salesforce:1.0.0", "google-drive:1.0.0", "google-calendar:1.0.0", "google-docs:1.0.0", "google-sheet:1.0.0", "google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 25962
externalPort = 80

[nix]
channel = "stable-25_05"
